# PRISM local environment template
# Copy this file to .env.local for local development.
# Keep all values empty in this example file. Never commit .env or .env.local.

# Public frontend variables
# These are injected into the Vite client bundle. Only use public, browser-safe values here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server runtime variables
# These are used by TanStack server routes and must never be exposed in frontend code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Market data providers
FINNHUB_API_KEY=
OPENFIGI_API_KEY=
TWELVE_DATA_API_KEY=
GNEWS_API_KEY=

# AI / Lovable server integrations
ANTHROPIC_API_KEY=
LOVABLE_API_KEY=

# Stripe server-only secrets
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Tink server-only credentials
TINK_CLIENT_ID=
TINK_CLIENT_SECRET=
TINK_REDIRECT_URI=

# Make.com webhook verification
MAKE_WEBHOOK_SECRET=

# Supabase admin key
# Server-only. Never use or expose this in browser/frontend code.
SUPABASE_SERVICE_ROLE_KEY=
