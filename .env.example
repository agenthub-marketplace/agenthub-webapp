# Public frontend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only
SUPABASE_SERVICE_ROLE_KEY=

# Access and payments
# ACCESS_MODE=free_beta with PAYMENTS_PROVIDER=none activates direct beta access without Stripe.
# ACCESS_MODE=paid with PAYMENTS_PROVIDER=stripe requires checkout + webhook before access.
ACCESS_MODE=free_beta
PAYMENTS_PROVIDER=none

# Stripe Checkout
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Connect planned
STRIPE_CONNECT_CLIENT_ID=

# Agent execution gateway planned
AGENT_GATEWAY_SECRET=
AGENT_WEBHOOK_SECRET=

# LLM Runner v0
LLM_RUNS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
LLM_RUN_MAX_INPUT_CHARS=4000
LLM_RUN_MAX_OUTPUT_TOKENS=900
LLM_RUNS_PER_RENTAL_PER_DAY=10
LLM_RUNS_PER_USER_PER_DAY=30

# Document/File runtime beta
DOCUMENT_RUNS_ENABLED=false
DOCUMENT_MAX_FILE_BYTES=3500000
DOCUMENT_MAX_EXTRACTED_CHARS=30000
DOCUMENT_FILE_RETENTION_DAYS=7
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# App
NEXT_PUBLIC_APP_URL=
