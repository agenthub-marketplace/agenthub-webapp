# Public frontend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only
SUPABASE_SERVICE_ROLE_KEY=

# Access and payments
# ACCESS_MODE=free_beta with PAYMENTS_PROVIDER=none activates direct beta access without Stripe.
# ACCESS_MODE=paid with PAYMENTS_PROVIDER=stripe requires checkout + webhook before access.
ACCESS_MODE=free_beta
PAYMENTS_PROVIDER=none

# Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Connect planned
STRIPE_CONNECT_CLIENT_ID=

# Agent execution gateway planned
AGENT_GATEWAY_SECRET=
AGENT_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=
