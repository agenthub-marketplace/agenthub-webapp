# ─────────────────────────────────────────────────────────────
# Lovable Cloud (Supabase) — auto-provisioned, do not edit in prod
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# ─────────────────────────────────────────────────────────────
# Server-side runtime secrets (configured via Lovable Cloud → Secrets)
# These are read from process.env in TanStack server routes / edge functions.
# ─────────────────────────────────────────────────────────────

# Market data
FINNHUB_API_KEY=
OPENFIGI_API_KEY=

# News provider
GNEWS_API_KEY=

# AI (alert analysis)
ANTHROPIC_API_KEY=
LOVABLE_API_KEY=

# Stripe (subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Tink (broker connection)
TINK_CLIENT_ID=
TINK_CLIENT_SECRET=
TINK_REDIRECT_URI=

# Make.com webhook (admin watchlist push)
MAKE_WEBHOOK_SECRET=

# Supabase service role (server-only — NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=
